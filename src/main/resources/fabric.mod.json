{
	"schemaVersion": 1,
	"id": "always-on-locator-bar",
	"version": "${version}",
	"name": "Always On Locator Bar",
	"description": "Keeps the locator bar visible at all times even when while the XP bar is animating absorbed experience.",
	"authors": [
		"OrangoPontoTango"
	],
	"contact": {
		"homepage": "https://modrinth.com/always-on-locator-bar",
		"sources": "https://github.com/maker-lukas/always-on-locator-bar"
	},
	"license": "AGPL-3.0-or-later",
	"icon": "assets/always-on-locator-bar/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.orangopontotango.alwaysonlocatorbar.client.AlwaysOnLocatorBarClient"
		],
		"modmenu": [
			"com.orangopontotango.alwaysonlocatorbar.client.config.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "always-on-locator-bar.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.2",
		"minecraft": "~26.1.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}